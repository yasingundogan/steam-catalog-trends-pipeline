# Copy this file to .env and fill in your own values. NEVER commit .env.

# Steam Web API key (only needed for the app list endpoint)
# Get one at https://steamcommunity.com/dev/apikey
STEAM_API_KEY=your-key-here

# Endpoints
STEAM_APPLIST_URL=https://api.steampowered.com/IStoreService/GetAppList/v1/
STEAM_APPDETAILS_URL=https://store.steampowered.com/api/appdetails
STEAM_REVIEWS_URL=https://store.steampowered.com/appreviews

# Store region: appdetails prices depend on the country code (document it in docs/sources.md)
STEAM_COUNTRY_CODE=us

# Request behaviour
REQUEST_TIMEOUT=30
MAX_RETRIES=5
BACKOFF_BASE_SECONDS=5
BACKOFF_MAX_SECONDS=120
# appdetails allows ~200 requests / 5 min, so keep at least 1.5 s between requests
REQUEST_DELAY_SECONDS=1.6

# Sampling: how many apps per run (0 = every app in the list, takes many hours)
# Use 20-50 while developing, 1500 for the final run (~80 min: 2 requests per app)
MAX_APPS=1500
SAMPLE_SEED=42
APPLIST_PAGE_SIZE=50000

# Where raw responses are written (relative to the repository root)
RAW_DATA_DIR=data/raw
